    "Aktive Freigaben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active shares"
          }
        }
      }
    },
    "Aktivität": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Activity"
          }
        }
      }
    },
    "Aktualisieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh"
          }
        }
      }
    },
    "Alle Dateien zusätzlich auf diesem Mac halten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Also keep every file on this Mac"
          }
        }
      }
    },
    "Alle Fassungen …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All versions …"
          }
        }
      }
    },
    "Alle bereits verschickten Links zu diesem Ordner hören sofort auf zu funktionieren. Die Dateien selbst bleiben unverändert.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every link to this folder that has already been sent stops working immediately. The files themselves stay untouched."
          }
        }
      }
    },
    "Alle sichern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up all"
          }
        }
      }
    },
    "Alles kopieren (mit Anleitung)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy everything (with instructions)"
          }
        }
      }
    },
    "Alles synchron": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything in sync"
          }
        }
      }
    },
    "Allgemein": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "General"
          }
        }
      }
    },
    "Anhalten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause"
          }
        }
      }
    },
    "Anna": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anna"
          }
        }
      }
    },
    "Ansehen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View"
          }
        }
      }
    },
    "Auch die vorhandenen Aufnahmen mitnehmen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take the existing photos along as well?"
          }
        }
      }
    },
    "Auf dem neuen Gerät Spind öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Spind on the new device"
          }
        }
      }
    },
    "Auf der Box gelöscht": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted on the box"
          }
        }
      }
    },
    "Aufteilung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split"
          }
        }
      }
    },
    "Authentifizierung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentication"
          }
        }
      }
    },
    "Beenden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quit"
          }
        }
      }
    },
    "Bei Anmeldung starten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start at login"
          }
        }
      }
    },
    "Beides liegt auf dem Server: Gelöschtes und frühere Fassungen sind hier auch dann zu finden, wenn dieses iPhone die Datei nie geladen hat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both live on the server: deleted files and earlier versions turn up here even when this iPhone never downloaded the file."
          }
        }
      }
    },
    "Beispiel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example"
          }
        }
      }
    },
    "Benutzer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User"
          }
        }
      }
    },
    "Benutzername": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username"
          }
        }
      }
    },
    "Bereit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready"
          }
        }
      }
    },
    "Bereit zum Scannen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to scan"
          }
        }
      }
    },
    "Bilder": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Images"
          }
        }
      }
    },
    "Collabora-Server": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collabora server"
          }
        }
      }
    },
    "Danach erscheint Spind in der Dateien-App unter »Durchsuchen«. Dateien laden erst beim Öffnen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After that, Spind appears in the Files app under “Browse”. Files download when you open them."
          }
        }
      }
    },
    "Darf nur lesen, nicht ändern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "May only read, not change"
          }
        }
      }
    },
    "Dateien-App-Eintrag neu anlegen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recreate the Files app entry"
          }
        }
      }
    },
    "Deine Dateien findest du in der **Dateien-App** unter »Durchsuchen« → **Spind**. Sie laden erst beim Öffnen und belegen sonst keinen Platz.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will find your files in the **Files app** under “Browse” → **Spind**. They download when you open them and take up no space otherwise."
          }
        }
      }
    },
    "Den QR-Code aus der Mac-App scannen (Einstellungen → Verbindung → »Gerät verbinden«).": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan the QR code from the Mac app (Settings → Connection → “Connect a device”)."
          }
        }
      }
    },
    "Der Freigabe-Server wird eingerichtet – das kann bis zu zwei Minuten dauern. Der Link erscheint, sobald er wirklich erreichbar ist.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Setting up the share server — this can take up to two minutes. The link appears once it is actually reachable."
          }
        }
      }
    },
    "Der Port muss zwischen 1 und 65535 liegen – Storage Boxen nutzen 23.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The port must be between 1 and 65535 — Storage Boxes use 23."
          }
        }
      }
    },
    "Die aktuelle Fassung wird dabei als neue Version gesichert – du kannst also jederzeit zurück.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current version is kept as a new version in the process — so you can go back at any time."
          }
        }
      }
    },
    "Die letzte gesicherte Fassung kommt an ihren alten Platz zurück und wird beim nächsten Abgleich auch wieder lokal angelegt.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last kept version returns to its old place and is created locally again at the next sync."
          }
        }
      }
    },
    "Die zuletzt gesicherte Fassung kommt an ihren alten Platz zurück – auf allen Geräten.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most recently kept version returns to its old place — on every device."
          }
        }
      }
    },
    "Diese Fassung wiederherstellen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restore this version?"
          }
        }
      }
    },
    "Diesen Code scannen – fertig": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this code — done"
          }
        }
      }
    },
    "Diesen Schlüssel kannst du bei weiteren Boxen oder Servern hinterlegen – er bleibt auf diesem iPhone immer derselbe.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can deposit this key with further boxes or servers — on this iPhone it always stays the same."
          }
        }
      }
    },
    "Dieser Ordner ist bereits geteilt. Das Passwort wurde auf diesem Gerät nicht gespeichert – erzeuge einen neuen Zugangslink, um ihn erneut weiterzugeben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is already shared. The password was not saved on this device — generate a new access link to pass it on again."
          }
        }
      }
    },
    "Dieser Ordner ist leer": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This folder is empty"
          }
        }
      }
    },
    "Dunkel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dark"
          }
        }
      }
    },
    "Durchsuche den Verlauf …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching the history …"
          }
        }
      }
    },
    "Eingerichtet – Spind läuft": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All set — Spind is running"
          }
        }
      }
    },
    "Einrichtung zurücksetzen …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset the setup …"
          }
        }
      }
    },
    "Einrichtung zurücksetzen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reset the setup?"
          }
        }
      }
    },
    "Einstellungen öffnen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        }
      }
    },
    "Eintragen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter"
          }
        }
      }
    },
    "Empfänger können Dateien ansehen und herunterladen – über den Link im Browser oder als eingebundenes Laufwerk.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipients can view and download files — via the link in a browser or as a mounted drive."
          }
        }
      }
    },
    "Empfänger können Dateien auch ändern und hochladen. Bearbeiten funktioniert über die Laufwerk-Einbindung (Finder: ⌘K / Windows-Explorer); die Web-Ansicht bleibt lesend.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recipients can also change and upload files. Editing works through the mounted drive (Finder: ⌘K / Windows Explorer); the web view stays read-only."
          }
        }
      }
    },
    "Entfernt Zugang und Schlüssel von diesem iPhone. Auf dem Server ändert sich nichts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes the access and the key from this iPhone. Nothing changes on the server."
          }
        }
      }
    },
    "Entlädt lange ungenutzte Dateien aus dem Finder-Volume; sie bleiben in der Cloud verfügbar.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Evicts long-unused files from the Finder volume; they stay available in the cloud."
          }
        }
      }
    },
    "Erneut versuchen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try again"
          }
        }
      }
    },
    "Erscheinungsbild": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Appearance"
          }
        }
      }
    },
    "Erstelle Freigabe …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating share …"
          }
        }
      }
    },
    "Fehler: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Error: %@"
          }
        }
      }
    },
    "Fertig": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done"
          }
        }
      }
    },
    "Fertig – in der Dateien-App aktivieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Done — now switch it on in the Files app"
          }
        }
      }
    },
    "Finder-Laufwerk": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder drive"
          }
        }
      }
    },
    "Finder-Laufwerk neu aufbauen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuild the Finder drive?"
          }
        }
      }
    },
    "Fotos": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos"
          }
        }
      }
    },
    "Fotos sichern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up photos"
          }
        }
      }
    },
    "Fragt beim Öffnen der App nach. Schützt Zugang, Papierkorb und Verlauf – **nicht** die Dateien selbst: die stehen weiter in der Dateien-App.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Asks when the app is opened. Protects access, trash and history — **not** the files themselves: those remain in the Files app."
          }
        }
      }
    },
    "Freigabe erstellen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create share"
          }
        }
      }
    },
    "Freigabe erstellt – Zugang im Clipboard": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share created — credentials on the clipboard"
          }
        }
      }
    },
    "Freigabe widerrufen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke share"
          }
        }
      }
    },
    "Freigabe widerrufen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Revoke share?"
          }
        }
      }
    },
    "Freigeben, wenn ungenutzt seit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Free up when unused for"
          }
        }
      }
    },
    "Für Geräte, die ihren Schlüssel selbst erzeugt haben: öffentlichen Schlüssel hier einfügen, Spind trägt ihn auf dem Server ein.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For devices that generated their own key: paste the public key here and Spind enters it on the server."
          }
        }
      }
    },
    "Für die Storage Box stehen die Angaben in der Hetzner Console; bei einem eigenen Server kennst du sie selbst.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For a Storage Box the details are in the Hetzner Console; on your own server you know them yourself."
          }
        }
      }
    },
    "Gelöschte Dateien": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted files"
          }
        }
      }
    },
    "Gemeinsam bearbeiten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Collaborative editing"
          }
        }
      }
    },
    "Gerät verbinden": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a device"
          }
        }
      }
    },
    "Gerät verbinden …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a device …"
          }
        }
      }
    },
    "Geteilt · Lesen & Schreiben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared · read & write"
          }
        }
      }
    },
    "Geteilt · nur Lesen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shared · read-only"
          }
        }
      }
    },
    "Gilt für Spind selbst. Der Finder, die Freigabe-Seite im Browser und die Meldungen des Systems folgen weiterhin dem Rechner.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to Spind itself. The Finder, the share page in the browser and the system's own messages still follow this Mac."
          }
        }
      }
    },
    "Gilt für Spind selbst. Der Finder, die Freigabe-Seite im Browser und die Meldungen des Systems folgen weiterhin der Sprache des Rechners.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to Spind itself. The Finder, the share page in the browser and the system's own messages still follow the language of this Mac."
          }
        }
      }
    },
    "Gilt für Spind selbst. Die Dateien-App und die Meldungen des Systems folgen weiterhin dem Gerät.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to Spind itself. The Files app and the system's own messages still follow the device."
          }
        }
      }
    },
