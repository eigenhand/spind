    "90 Tagen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "90 days"
          }
        }
      }
    },
    "Abbrechen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        }
