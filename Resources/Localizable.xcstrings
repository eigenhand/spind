{
  "sourceLanguage": "de",
  "strings": {
    "%@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@"
          }
        }
      }
    },
    "%@ von %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ von %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ of %2$@"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ · %2$@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%lld Löschungen bestätigen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm %lld deletions"
          }
        }
      }
    },
    "%lld Löschungen wirklich übertragen?": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Really sync %lld deletions?"
          }
        }
      }
    },
    "%lld frühere Fassungen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld previous versions"
          }
        }
      }
    },
    "%lld von %lld": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld von %2$lld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld of %lld"
          }
        }
      }
    },
    "%lld wiederherstellbar": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld recoverable"
          }
        }
      }
    },
    "%lld übersprungen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld skipped"
          }
        }
      }
    },
    "**Rechtsklick** auf Dateien und Ordner im Spind-Laufwerk: Ordner teilen, Versionsverlauf, auf dem Computer behalten, Platz freigeben.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Right-click** files and folders in the Spind drive: share a folder, version history, keep on this Mac, free up space."
          }
        }
      }
    },
    ". (= alles)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ". (= everything)"
          }
        }
      }
    },
    "1 · Schlüssel": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "1 · Key"
          }
        }
      }
    },
    "14 Tagen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "14 days"
          }
        }
      }
    },
    "2 · Verbindung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 · Connection"
          }
        }
      }
    },
    "30 Tagen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "30 days"
          }
        }
      }
    },
    "7 Tagen": {
      "localizations": {
