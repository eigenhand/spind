    "Jetzt sichern": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up now"
          }
        }
      }
    },
    "Keine Verbindung": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No connection"
          }
        }
      }
    },
    "Keine aktiven Freigaben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No active shares"
          }
        }
      }
    },
    "Konflikt – beide Versionen behalten": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflict — kept both versions"
          }
        }
      }
    },
    "Kopieren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy"
          }
        }
      }
    },
    "Kopiert!": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copied!"
          }
        }
      }
    },
    "Lade Verlauf …": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loading history …"
          }
        }
      }
    },
    "Lange ungenutzte Dateien werden lokal entfernt und bleiben als Cloud-Platzhalter im Finder sichtbar – beim Öffnen lädt Spind sie automatisch wieder. Dateien mit »Geladen behalten« (Rechtsklick im Finder) und nicht hochgeladene Änderungen sind ausgenommen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long-unused files are removed locally and stay visible in Finder as cloud placeholders — opening one downloads it again automatically. Files marked “Keep downloaded” (right-click in Finder) and changes not yet uploaded are exempt."
          }
        }
      }
    },
    "Lesen & Schreiben": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read & write"
          }
        }
      }
    },
    "Link (öffnet die Freigabe-Seite)": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link (opens the share page)"
          }
        }
      }
    },
    "Lokal gelöscht": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deleted locally"
          }
        }
      }
    },
    "Lokaler Sync-Ordner": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local sync folder"
          }
        }
      }
    },
    "Läuft": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Running"
          }
        }
      }
    },
    "Löschungen übertragen": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync deletions"
          }
        }
      }
    },
    "Meldet den aktuellen Sync-Status.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reports the current sync status."
          }
        }
      }
    },
    "Mit %@ entsperren": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock with %@"
          }
        }
      }
    },
    "Mit %@ öffnen": {
