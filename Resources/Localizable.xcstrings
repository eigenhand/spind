    "Willkommen bei Spind": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Spind"
          }
        }
      }
    },
    "Wird eine Datei gelöscht, die schon einmal gesichert wurde, taucht sie hier auf und lässt sich zurückholen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a file that has been kept before is deleted, it turns up here and can be brought back."
          }
        }
      }
    },
    "Wird eine Datei gelöscht, die schon mal gesichert wurde, taucht sie hier auf und lässt sich zurückholen.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a file that has been kept before is deleted, it turns up here and can be brought back."
          }
        }
      }
    },
